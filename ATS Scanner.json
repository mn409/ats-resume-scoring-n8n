{
  "name": "ATS Resume Scoring Automation",
  "nodes": [
    {
      "type": "n8n-nodes-base.manualTrigger",
      "name": "When clicking ‘Execute workflow’",
      "position": [0, 0]
    },
    {
      "type": "n8n-nodes-base.googleDrive",
      "name": "JD - file",
      "parameters": {
        "operation": "download",
        "fileId": "YOUR_JD_FILE_ID",
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "position": [200, 0]
    },
    {
      "type": "n8n-nodes-base.googleDrive",
      "name": "Resume Folder",
      "parameters": {
        "resource": "fileFolder",
        "searchMethod": "query",
        "queryString": "name contains 'Resume'",
        "filter": {
          "folderId": "YOUR_RESUME_FOLDER_ID"
        }
      },
      "position": [400, 0]
    },
    {
      "type": "n8n-nodes-base.extractFromFile",
      "name": "Extract from File",
      "parameters": {
        "operation": "text"
      },
      "position": [800, 0]
    },
    {
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "name": "Basic LLM Chain",
      "parameters": {
        "promptType": "define",
        "text": "You are an ATS resume parser...\n\nResume text:\n{{ $json.text }}"
      },
      "position": [1000, 0]
    },
    {
      "type": "n8n-nodes-base.googleSheets",
      "name": "Append row in sheet",
      "parameters": {
        "operation": "append",
        "documentId": "YOUR_GOOGLE_SHEET_ID",
        "sheetName": "resume_score"
      },
      "position": [1400, 0]
    }
  ],
  "connections": {},
  "active": false
}
